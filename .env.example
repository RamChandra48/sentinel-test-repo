# Fraud scoring service environment variables

# Version of the fraud detection model to load (e.g. 2.0.0, 2.1.0)
FRAUD_MODEL_VERSION=2.0.0

# Score threshold above which a transaction is flagged as fraudulent (0–1)
FRAUD_SCORE_THRESHOLD=0.75

# Maximum number of input features forwarded to the model
FRAUD_MAX_FEATURES=50

# Timeout (ms) for a single model inference call
FRAUD_MODEL_TIMEOUT_MS=3000

# Server port
PORT=3000
